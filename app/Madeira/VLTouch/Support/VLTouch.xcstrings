    "First Launch Tips": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First Launch Tips"
          }
        }
      }
    },
    "firstLaunchTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n1. By default, The widget menu button will be automatically docked to bottom edge, then become almost transparent after staying idle for 2 seconds. \nThis timeout can be changed by entering “Edit” in the widget menu.\n\n2. From %@ edge, slide %d%% screen width to open settings menu\n\n3. From %@ edge, slide %d%% screen width to open toolbox menu\n\n4. Slide from top 40%% of screen edge to avoid sending touch events to PC side"
          }
        }
      }
    },
    "firstPressureCurvePersistTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressure curve saved with current game profile. To switch game profile, tap the [gamepad icon] on navigation bar.\nWhen you switch game profile, pressure curve will change too."
          }
        }
      }
    },
    "firstTappingPushToTalkTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system saves separate volume levels for voice capture and normal audio modes. You may need to manually adjust the volume in each mode to balance their perceived loudness."
          }
        }
      }
    },
    "Floating Keyboard Button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating Keyboard Button"
          }
        }
      }
    },
    "Floating keyboard not supported": {
      "localizations": {
