      }
    },
    "Folder Button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder Button"
          }
        }
      }
    },
    "folderButtonModeTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder button supports the following modes:\n\n- Slide and hold: Expands while pressed and collapses when released. Double-tap and hold to drag during streaming.\n\n- Movable: Tap to toggle expand/collapse. Long press to enter draggable mode.\n\n- Normal: Tap to toggle expand/collapse state. Cannot be dragged and moved during streaming."
          }
        }
      }
    },
    "folderTutorialTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCollect widgets into folder: drag other widgets (buttons or touchpads). Release when the touch point enters the folder’s bounding frame.\n\n- When the folder is unfolded, the collected widget will snap back to its original position. Otherwise, the collected widget will be hidden\n\n- Drag a sub-widget or a folder over the trash icon (do not release) to detach it from the collection.\n\n- The [Widgets] folder button (you just selected) can be dragged & relocated during streaming by quick double tap and keep holding-down."
          }
        }
      }
    },
    "folderTutorialUrl": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https://voidlink.yuque.com/org-wiki-voidlink-znirha/fa3tgr/it0qruyul6be8gr1"
          }
        }
      }
    },
    "Force pencil entering hovering on host": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force pencil entering hovering on host"
          }
        }
      }
    },
    "Frame Pacing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame Pacing"
          }
        }
      }
    },
    "Frame Rate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame Rate"
          }
        }
      }
    },
    "frameInterpolationResolutionTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "- In general, higher interpolation resolutions require more processing power.\n\n- Most devices with A15 or newer chips can interpolate 60 FPS to 120 FPS at the default interpolation resolution (around 720p).\nRecommended configurations for your reference:\niPhone 13 Pro (A15) - 1344 × 624\niPad Pro 2024 (M4) - 1440 × 992\n\n- Upgrade to iOS 27 to unlock interpolation resolutions above 720p.\n\n- If you experience increased input latency, stuttering, or other issues, lower the interpolation resolution.\n\n- There is always a setting that balances image quality and performance for stable frame interpolation.\n\n- Older models may not be able to initiate the interpolator(such as A12 SoC devices)"
          }
        }
      }
    },
    "framePacingStackTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "- Off = no frame pacing, previously “Lowest Latency”.\n\n- Legacy, previously “Smoothest Video” (though it’s not the smoothest option anymore)"
          }
        }
      }
    },
