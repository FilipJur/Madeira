    "keyboard&MouseStreamingTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nKeyboard Shortcuts for VoidLink (Desktop Mode):\n\nCtrl(Control) + Alt(Opt) + Shift + D — Disconnect the current session\n\nCtrl(Control) + Alt(Opt) + Shift + Q — Disconnect the current session and quit current app\n\nCtrl(Control) + Alt(Opt) + Shift + S — Expand the settings menu\n\nCtrl(Control) + Alt(Opt) + Shift + O — Toggle the statistics overlay\n\nCtrl(Control) + Alt(Opt) + Shift + C — Toggle mouse pointer visibility\n\nBy default, the mouse cursor can’t be moved out of app window. To do this, please disconnect the current session, then go to Settings → Peripheral Section → Local Mouse Cursor, and select “Visible” (Note: you can’t control the camera in 3D games by this mode)"
          }
        }
      }
    },
