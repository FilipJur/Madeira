    "G8PlusMFiRegressionTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dear G8+ MFi controller user, due to Apple App Review requirements, VoidLink updates have had to remove the MFi-protocol vibration feature for this controller. We sincerely apologize. As a temporary workaround, you may install the TestFlight version where this functionality remains unaffected. Whether this feature can be restored in a future version depends on VoidLink obtaining MFi authorization from the controller manufacturer."
          }
        }
      }
    },
