    "touchModeStackTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "- Touchpad: Laptop-style controls. Double-tap and hold to drag, two-finger tap to right-click, two-finger swipe to scroll. Cannot be used for 3D games. Use the MousePad widget instead.\n\n- Touchpad Native Mode: Passes through native Windows touchpad gestures. Requires Sunshine-Foundation.\n\n- Native Touch: Use your PC as a Windows tablet. Not supported on macOS host.\n\n- Single Point: Provides a touchscreen-like experience on macOS."
          }
        }
      }
    },
