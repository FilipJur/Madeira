    "externalAudioSelectionTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is audio playing through a speaker or earphones? Speaker enables voice processing to reduce echo. EarPhone disables voice processing to preserve playback quality."
