    "gamepadOverlayFeatureTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello! I'm the VoidLink gamepad live feedback overlay. \n\n1. You can use the \"🎮 overlay” button in the widget menu to turn me on or off.\n\n2. I can be resized by double-tap or two-finger pinch, and moved by dragging directly."
          }
        }
      }
    },
    "gameProfileIntroduction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "- Long press a game profile to reorder.\n\n- The on-screen widget layout (including the virtual gamepad, virtual buttons, etc.), as well as the options in the settings menu marked with a [gamepad icon] (such as motion control settings), are all saved in the game profile.\n\n- To switch game profile during streaming, swipe inward from the %@ edge of the screen by %@ of screen width, open [Switch Game Profile] in the toolbox menu"
          }
        }
      }
    },
    "gameProfileStackTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting is saved in [Game Profile]. To open game profile selector:\n- Tap the gamepad icon on navigation bar\n- While streaming, swipe inward from the %@ edge of the screen by %@ of screen width, open [Switch Game Profile] in the toolbox menu\n- Also available by controller radial menu -> [more options]"
          }
        }
      }
    },
    "gamingLayoutFolderTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best way to edit your gaming widgets for this universal template:\n\n- Edit on another profile instead of current complicated layout\n- Unfold current folder\n- Tap “clear” to remove sub-widgets\n- Tap “import” and select the edited target profile\n- Gaming widgets will be imported to current folder\n(“Widgets”, “Layouts” & “Edit layout” buttons will be filtered automatically)"
          }
        }
      }
    },
